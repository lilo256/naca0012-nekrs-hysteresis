      subroutine userchk
      include 'SIZE'
      include 'TOTAL'
      
      
      return
      end

c-----------------------------------------------------------------------
      subroutine usrdat   ! This routine to modify element vertices
      include 'SIZE'      ! _before_ mesh is generated, which 
      include 'TOTAL'     ! guarantees GLL mapping of mesh.
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      include 'SIZE'
      include 'TOTAL'
         integer e,f

    !Set all non-periodic BCs here. This is required by gmsh2nek
      do iel=1,nelv
         do ifc=1,2*ndim
            id_face = bc(5,ifc,iel,1)
	    if (id_face.eq.1) then        ! BC1_on_INLET
               cbc(ifc,iel,1) = 'v  '
               boundaryID(ifc,iel) = 1
            elseif (id_face.eq.2) then    ! BC1_on_OUTLET
               cbc(ifc,iel,1) = 'o  '
               boundaryID(ifc,iel) = 2
            elseif (id_face.eq.3) then    ! BC1_on_TOP
               cbc(ifc,iel,1) = 'sym'
               boundaryID(ifc,iel) = 3
            elseif (id_face.eq.4) then    ! BC1_on_BOTTOM
               cbc(ifc,iel,1) = 'sym'
               boundaryID(ifc,iel) = 4
            elseif (id_face.eq.5) then    ! BC1_on_UPPSURF
               cbc(ifc,iel,1) = 'W  '
               boundaryID(ifc,iel) = 5
            elseif (id_face.eq.6) then    ! BC1_on_LOWSURF
               cbc(ifc,iel,1) = 'W  '
               boundaryID(ifc,iel) = 6
            elseif (id_face.eq.7) then    ! BC1_on_FRONT
               cbc(ifc,iel,1) = 'sym'
               boundaryID(ifc,iel) = 7
            elseif (id_face.eq.8) then    ! BC1_on_BACK
               cbc(ifc,iel,1) = 'sym'
               boundaryID(ifc,iel) = 8

            else                          ! Zero-out everything else
               cbc(ifc,iel,1) = '   '
               boundaryID(ifc,iel) = 0
            endif
         enddo
      enddo
      
      
   

	n = lx1*ly1*lz1*nelv
	nxz = nx1*nz1
	nface = 2*ldim

	do iel=1,nelv
	do ifc=1,2*ndim
	   if (abs((bc(5,ifc,iel,1)-5.0)).lt.1e-4) cbc(ifc,iel,1)= 'W  '
	   if (abs((bc(5,ifc,iel,1)-6.0)).lt.1e-4) cbc(ifc,iel,1)= 'W  '
	enddo
	enddo
   
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      real w1(lx1*ly1*lz1*lelv), w2(lx1*ly1*lz1*lelv),
     &     w3(lx1*ly1*lz1*lelv), w4(lx1*ly1*lz1*lelv),
     &     w5(lx1*ly1*lz1*lelv)
      common /scrach_o1/ w1, w2, w3, w4, w5

      real ywd(lx1*ly1*lz1*lelv)
      common /scrach_o2/ ywd

      integer i, iel, k
      character*32 fname

      ! Appel corrigé : ifield = 1 (champ de vitesse)
      ! La fonction identifie toutes les frontières 'W  ' du domaine
      call distf(ywd, 1, 'W  ', w1, w2, w3, w4, w5)

      ! Export direct
      write(fname, '("wall_distance_rank_",I4.4,".csv")') nid
      open(unit=77, file=fname, status='replace')
      write(77, '("x,y,z,wall_distance")')
      
      i = 1
      do iel = 1, nelv
         do k = 1, lx1*ly1*lz1
            write(77, '(E15.7,A,E15.7,A,E15.7,A,E15.7)') 
     &      xm1(k,1,1,iel), ',', ym1(k,1,1,iel), ',',
     &      zm1(k,1,1,iel), ',', ywd(i)
            i = i + 1
         enddo
      enddo
      
      close(77)

      return
      end
