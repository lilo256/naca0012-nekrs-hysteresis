      subroutine usrsetvert(glo_num,nel,nx,ny,nz) ! to modify glo_num
 

      return
      end
c-----------------------------------------------------------------------
      subroutine shear_stress(cf,xf,u,v,w)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      parameter (lt=lx1*ly1*lz1*lelt,lxyz=lx1*ly1*lz1)

      real cf(lx1,lelt), xf(lx1,lelt), u(lt), v(lt), w(lt)

      common /scrns/ sij(lxyz,3*(ldim-1),lelt)
      common /scruz/ ua(lt),va(lt),wa(lt)
      common /scrmg/ ur (lxyz) , us (lxyz) , ut (lxyz)
     $             , vr (lxyz) , vs (lxyz) , vt (lxyz)
     $             , wr (lxyz) , ws (lxyz) , wt (lxyz)

      call comp_sij(sij,3*(ldim-1),u,v,w,ur,us,ut,vr,vs,vt,wr,ws,wt)

      visc = param(2)

      call rzero(cf,lx1*lelt)
      call rzero(xf,lx1*lelt)

      do e=1,nelv
         do f=1,2*ndim
		if (cbc(f,1,e).eq.'W  ') then
                  if (bc(5,f,e,1).eq.5 .or. bc(5,f,e,1).eq.6) then

                     do k=1,lx1

                        ! 
                        sxx = sij(k,1,e)
                        syy = sij(k,2,e)
                        syx = sij(k,ldim+1,e)

                        ! 
                        tnx = -uny(k,1,f,e)
                        tny =  unx(k,1,f,e)

                        ! 
                        cf(k,e) = tnx*sxx*unx(k,1,f,e) 
     $                          + tny*syx*unx(k,1,f,e) 
     $                          + tnx*syx*uny(k,1,f,e) 
     $                          + tny*syy*uny(k,1,f,e) 
                        cf(k,e) = -visc * cf(k,e)

                        xf(k,e) = xm1(k,1,1,e)

                     enddo
                  endif
               endif
         enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
